<?xml version="1.0" encoding="utf-8"?>
<!-- Engineered by uncoalesced -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />

    <application>
        <service
            android:name=".ime.StickyKeysIME"
            android:label="FluxBoard"
            android:icon="@drawable/ic_keyboard_flux"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Declared, never auto enabled. The permission below is granted only from the
             system Settings screen, and only after the user has turned on FluxBoard's own
             opt in and read what the grant actually covers. Everything the media row does
             without it keeps working exactly as before; see MediaTransport.

             The service itself reads no notification content, and
             scripts/check-source-rules.sh fails the build if an onNotification override is
             ever added to it. -->
        <service
            android:name=".ime.MediaMetadataListenerService"
            android:label="FluxBoard media info"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Not the stock FileProvider: stickers are stored as ".sticker", an extension
             MimeTypeMap cannot resolve, so getType() answered null for every sticker and
             any app that checks the URI's own type before accepting it (WhatsApp, Discord)
             refused the content. The subclass reads the type from the file header. -->
        <provider
            android:name="com.uncoalesced.stickykeys.stickercore.data.file.StickerFileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
