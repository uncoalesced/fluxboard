<?xml version="1.0" encoding="utf-8"?>
<!-- Engineered by uncoalesced -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />

    <application>
        <service
            android:name=".ime.StickyKeysIME"
            android:label="FluxBoard"
            android:icon="@drawable/ic_keyboard_flux"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- There is deliberately no NotificationListenerService here.

             v0.1.6-BETA briefly declared one, purely so the platform would answer
             MediaSessionManager.getActiveSessions() and the media row could show a track
             name. It was scoped as tightly as the platform allows: off by default, granted
             only from system Settings, and the service overrode no notification callback at
             all. None of that mattered. Google Play Protect blocks the install of any
             sideloaded app that merely *declares* BIND_NOTIFICATION_LISTENER_SERVICE, with
             "App blocked to protect your device", and it reads the manifest, not the class.

             FluxBoard is distributed only by sideloading, so that trade is not close: a
             permission that makes the app uninstallable for the entire audience cannot buy
             one line of track metadata. Transport controls never needed it and are
             unaffected; see MediaTransport, which is the permission-free path and is now
             the only one. Do not reintroduce this service, the feature it enabled is not
             worth what declaring it costs. scripts/check-source-rules.sh now fails the
             build if the declaration comes back. -->

        <!-- Not the stock FileProvider: stickers are stored as ".sticker", an extension
             MimeTypeMap cannot resolve, so getType() answered null for every sticker and
             any app that checks the URI's own type before accepting it (WhatsApp, Discord)
             refused the content. The subclass reads the type from the file header. -->
        <provider
            android:name="com.uncoalesced.stickykeys.stickercore.data.file.StickerFileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
