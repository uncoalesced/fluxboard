<?xml version="1.0" encoding="utf-8"?>
<!-- Engineered by uncoalesced -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />

    <application>
        <service
            android:name=".ime.StickyKeysIME"
            android:label="FluxBoard"
            android:icon="@drawable/ic_keyboard_flux"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Not the stock FileProvider: stickers are stored as ".sticker", an extension
             MimeTypeMap cannot resolve, so getType() answered null for every sticker and
             any app that checks the URI's own type before accepting it (WhatsApp, Discord)
             refused the content. The subclass reads the type from the file header. -->
        <provider
            android:name="com.uncoalesced.stickykeys.stickercore.data.file.StickerFileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
