<?xml version="1.0" encoding="utf-8"?>
<!-- Engineered by uncoalesced -->
<!-- Text editing: a text caret between left and right movement arrows. Deliberately not a
     pencil. A pencil reads as "compose" or "rename", whereas the panel behind this button
     moves the cursor and manipulates a selection rather than writing anything. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- I-beam caret -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:pathData="M12,4.6 L12,19.4 M10.2,4.6 L13.8,4.6 M10.2,19.4 L13.8,19.4" />
    <!-- Movement arrows -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M6.8,9 L3.4,12 L6.8,15 M17.2,9 L20.6,12 L17.2,15" />
</vector>
