    <string name="text_key_size">Key Size</string>
    <string name="text_key_size_summary">How large each key is drawn inside its space. Independent of the keyboard height.</string>
    <string name="text_double_space_period">Double-space for period</string>
    <string name="text_double_space_period_summary">Two quick taps of the space bar insert a full stop. Some apps do this themselves.</string>
    <string name="text_beta_notice_title">This is a beta build</string>
    <string name="text_beta_notice_body">Not a finished release. Expect rough edges, and please report anything that looks wrong, however small. Your typing stays on this device as always.</string>
    <string name="text_glide_typing">Glide typing</string>
    <string name="text_glide_typing_summary">Swipe across the letters to type a word instead of tapping each one. Tapping works exactly as before either way.</string>
    <string name="text_key_hints">Symbols on keys</string>
    <string name="text_key_hints_summary">Show the small symbol in the top-left corner of each key. Turn this off for a plainer keyboard. Holding a key still types its symbol either way.</string>
    <string name="text_private_mode">Private mode</string>
    <string name="text_private_mode_summary">Nothing you type is learned, suggested, corrected or saved to clipboard history. You turn this on and off yourself: password fields are already protected automatically, but an ordinary message box looks the same whatever is in it. Stays on until you turn it off. Also on the keyboard, under the arrow.</string>
