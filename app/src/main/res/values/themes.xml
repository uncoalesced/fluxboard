<?xml version="1.0" encoding="utf-8"?>
<!-- Engineered by uncoalesced -->
<resources>
    <!-- Light window chrome; values-night/themes.xml carries the Ink dark equivalent.
         Previously there was only one style, hardcoded to the dark Ink base, so a user
         on the light palette saw a dark flash before Compose drew. -->
    <style name="Theme.StickyKeys" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FFF7F5EE</item>
        <item name="android:statusBarColor">#FFF7F5EE</item>
        <item name="android:navigationBarColor">#FFF7F5EE</item>
    </style>
</resources>
