<?xml version="1.0" encoding="utf-8"?>
<!-- Engineered by uncoalesced -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required for LAN device migration (Phase 27/28) and the ephemeral
         link-sharing relay (Phase 29/30). All other features work offline. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Reading the gallery exists for one feature: "Extract Screenshot", which finds the
         newest screenshot on its own so turning one into a sticker costs a single tap rather
         than a trip through the picker. Requested at that button, never at launch.

         Three declarations because the platform renamed this twice, not because three kinds
         of access are wanted:
           - READ_MEDIA_IMAGES is the modern, images-only permission (API 33+). Notably it
             does NOT cover video or audio; the video import path deliberately still uses the
             photo picker, which needs no permission at all.
           - READ_MEDIA_VISUAL_USER_SELECTED (API 34+) is strictly *narrower*: it lets a user
             hand over only the pictures they choose. Declaring it is what makes "Select
             photos" appear alongside "Allow all", so nobody has to open their whole library
             to use one screenshot.
           - READ_EXTERNAL_STORAGE is the pre-API-33 spelling of the same thing, capped so it
             is never requested on a release that has the granular permissions. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!--
        Backup is enabled but scoped. Both rule files are required and must agree: Android 12+
        reads dataExtractionRules, Android 11 and below reads fullBackupContent, and the platform
        consults exactly one of them per device. Declaring allowBackup with neither - which is
        what this manifest did until now - means the permissive default, and that had the
        learned dictionary and the clipboard history eligible for upload.
    -->
    <application
        android:name=".StickyKeysApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StickyKeys">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.uncoalesced.stickykeys.app.LinkReceiverActivity"
            android:exported="true"
            android:theme="@style/Theme.StickyKeys">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="stickykeys.app" android:pathPrefix="/s" />
            </intent-filter>
        </activity>
    </application>
</manifest>
